<?xml version='1.0' encoding='utf-8'?>
<manifest xmlns:android='http://schemas.android.com/apk/res/android'>
    <uses-permission android:name='android.permission.FOREGROUND_SERVICE' />
    <uses-permission android:name='android.permission.FOREGROUND_SERVICE_DATA_SYNC' />
    <uses-permission android:name='android.permission.ACCESS_FINE_LOCATION' />
    <uses-permission android:name='android.permission.ACCESS_COARSE_LOCATION' />
    <uses-permission android:name='android.permission.SEND_SMS' />

    <application
        android:name='.MafzaApplication'
        android:allowBackup='false'
        android:dataExtractionRules='@xml/data_extraction_rules'
        android:fullBackupContent='@xml/backup_rules'
        android:label='${app_label}'
        android:supportsRtl='true'
        android:theme='@style/Theme.Mafza'>
        <activity
            android:name='.MainActivity'
            android:exported='true'
            android:theme='@style/Theme.Mafza'>
            <intent-filter>
                <action android:name='android.intent.action.MAIN' />
                <category android:name='android.intent.category.LAUNCHER' />
            </intent-filter>
        </activity>

        <service
            android:name='.emergency.EmergencyExecutionService'
            android:enabled='true'
            android:exported='false'
            android:foregroundServiceType='dataSync' />

        <receiver
            android:name='.emergency.EmergencyStartReceiver'
            android:enabled='true'
            android:exported='false'>
            <intent-filter>
                <action android:name='com.yshalsager.mafza.action.TRIGGER_SHORTCUT' />
                <action android:name='com.yshalsager.mafza.action.TRIGGER_WIDGET' />
                <action android:name='com.yshalsager.mafza.action.TRIGGER_QUICK_SETTINGS_TILE' />
            </intent-filter>
        </receiver>
    </application>

</manifest>
